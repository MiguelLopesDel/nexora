# Maintainer: Miguel Lopes Delmondes <miguellopesdelmondes2@gmail.com>
pkgname=nexora
pkgver=0.1.0
pkgrel=1
pkgdesc="Featherweight AI overlay assistant for Linux (Wayland-first)"
arch=('x86_64' 'aarch64')
url="https://github.com/MiguelLopesDel/nexora"
license=('AGPL-3.0-only')
depends=('gtk4' 'gtk4-layer-shell' 'libpulse' 'vulkan-icd-loader')
makedepends=('cargo' 'cmake' 'clang' 'vulkan-headers' 'shaderc')
optdepends=('ollama: local Vision/OCR and chat models')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('621f0e24db964be5c919e358a4dacecc4243433c874d045036e4382166a9c67d')

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/nexora "$pkgdir/usr/bin/nexora"
    install -Dm644 assets/dev.nexora.Nexora.desktop \
        "$pkgdir/usr/share/applications/dev.nexora.Nexora.desktop"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
